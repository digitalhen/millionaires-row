# Postgres connection for the Millionaires' Row web app.
# UI development runs against the ~10k-row sample database (fake coordinates):
DATABASE_URL=postgres://mrow:mrow@localhost:5435/mrow_dev
# At integration, point at the real roll:
# DATABASE_URL=postgres://mrow:mrow@localhost:5435/mrow

# Subpath the app is served from. Empty for the root-domain deployment (the
# production setup); set it only if the app is ever mounted under a subpath.
NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_BASE_PATH=/millionaires-row

# Absolute origin, used for canonical / Open Graph URLs (basePath, if any, is
# appended separately). Production: https://millionairesrownyc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://millionairesrownyc.com

# Optional pool tuning
# PGPOOL_MAX=10

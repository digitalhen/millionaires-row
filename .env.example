# Postgres connection for the Millionaires' Row web app.
# UI development runs against the ~10k-row sample database (fake coordinates):
DATABASE_URL=postgres://mrow:mrow@localhost:5435/mrow_dev
# At integration, point at the real roll:
# DATABASE_URL=postgres://mrow:mrow@localhost:5435/mrow

# Subpath the app is served from. Empty for the root-domain deployment (the
# production setup); set it only if the app is ever mounted under a subpath.
NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_BASE_PATH=/millionaires-row

# Absolute origin, used for canonical / Open Graph / sitemap / robots URLs
# (basePath, if any, is appended separately). NEXT_PUBLIC_* is inlined at BUILD
# time, so this has to be set for `next build`, not just at runtime, or the
# deployed site advertises localhost to crawlers and social scrapers.
# Production: https://millionairesrownyc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://millionairesrownyc.com

# Optional pool tuning
# PGPOOL_MAX=15
# Kill any query still running after this long, so no request can sit on a
# pool connection while others queue behind it. Nothing here is legitimately slow.
# PG_STATEMENT_TIMEOUT_MS=5000

# Per-IP rate limit for /api/* (token bucket). RATE_LIMIT_RPS=0 disables it.
# /api/health and /api/map/overview are always exempt.
# RATE_LIMIT_RPS=30
# RATE_LIMIT_BURST=60

# Size of the citywide map overview sample. Not settable per request — it is
# the one knob that would let a stranger re-run the 0.6s query at will.
# OVERVIEW_SAMPLE=76000
